{
  "name": "puredata",
  "version": "0.1.0",
  "description": "A comprehensive javascript validation and transformation library",
  "type": "module",
  "main": "val.js",
  "scripts": {
    "test": "node --import { tsx } --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{lib,_misc,tests}/**/*.ts\"",
    "lint:fix": "eslint \"{lib,_misc,tests}/**/*.ts\" --fix",
    "generate:chain-defs": "tsx ./generators/generate-chain-defs.ts",
    "push": "npm version patch && git push",
    "push-minor": "npm version minor && git push",
    "push-major": "npm version major && git push",
    "misc": "tsx ./_misc/misc.ts",
    "watch": "npm-watch misc",
    "test:unit": "node --import { tsx } --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/"
  },
  "author": "j0hnc0des",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^8.57.1",
    "jest": "^30",
    "npm-watch": "^0.13.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  },
  "watch": {
    "misc": {
      "patterns": [
        "lib/**/*.ts",
        "_misc/**/*.ts"
      ],
      "extensions": "ts"
    }
  }
}
