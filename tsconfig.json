{
  "compilerOptions": {
    "declaration": true,
    "lib": ["ES2015"],
    "target": "ES2015",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "noEmit": true,
    "noErrorTruncation": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "lib/**/*.ts",
    "lib/**/*.d.ts",
    "_misc/**/*.ts",
    "tests/**/*.ts"
, "tests/fields/array/ArrayHandler.bak"  ],
  "exclude": [
    "node_modules",
    "coverage"
  ]
}
